{
	"compilerOptions": {
		"allowJs": true,
		"baseUrl": "./",
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"es6"
		],
		"module": "commonjs",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"removeComments": false,
		"rootDir": "src",
		"sourceMap": true,
		"target": "es6"
	},
	"exclude": [
		"node_modules"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src/**/*",
		"test/**/*",
		"test-integration/**/*",
		"src",
		"src"
	]
}
